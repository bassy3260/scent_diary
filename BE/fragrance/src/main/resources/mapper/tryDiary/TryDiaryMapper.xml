<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fragrance.tryDiray.mapper.TryDiaryMapper">

    <resultMap id="tryDiaryListResultMap" type="com.example.fragrance.tryDiray.dto.TryDiaryListResponse">
        <result property="tryDiaryId" column="try_diary_id"/>
        <result property="title" column="title"/>
        <result property="createTime" column="created_time"/>
        <result property="thumbnail" column="image_route"/>
        <result property="perfumeName" column="perfume_name"/>
        <result property="brand" column="brand"/>
    </resultMap>

    <select id="findAll" resultMap="tryDiaryListResultMap">
        SELECT td.try_diary_id, td.title, td.created_time,
               p.image_route, p.perfume_name, p.brand
        FROM try_diary td
        LEFT JOIN try_diary_perfume tdp ON td.try_diary_id = tdp.try_diary_id
            AND <include refid="common.notDeletedWithAlias"><property name="alias" value="tdp"/></include>
            AND tdp.try_diary_perfume_id = (
                SELECT MIN(tdp2.try_diary_perfume_id)
                FROM try_diary_perfume tdp2
                WHERE tdp2.try_diary_id = td.try_diary_id
                  AND <include refid="common.notDeletedWithAlias"><property name="alias" value="tdp2"/></include>
            )
        LEFT JOIN perfume p ON tdp.perfume_id = p.perfume_id
        WHERE td.member_id = #{memberId}
          AND <include refid="common.notDeletedWithAlias"><property name="alias" value="td"/></include>
        ORDER BY td.created_time DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countByMemberId" resultType="int">
        SELECT COUNT(*)
        FROM try_diary
        WHERE member_id = #{memberId}
          AND <include refid="common.notDeleted"/>
    </select>

    <resultMap id="tryDiaryDetailResultMap" type="com.example.fragrance.tryDiray.dto.TryDiaryDetailResponse">
        <result property="tryDiaryId" column="try_diary_id"/>
        <result property="title" column="title"/>
        <result property="createTime" column="created_time"/>
        <collection property="tryItem" ofType="com.example.fragrance.tryDiray.dto.TryDiaryDetailResponse$TryItemInfo">
            <result property="perfumeId" column="perfume_id"/>
            <result property="perfumeImageUrl" column="image_route"/>
            <result property="perfumeName" column="perfume_name"/>
            <result property="brand" column="brand"/>
            <result property="description" column="description"/>
        </collection>
    </resultMap>

    <select id="findById" resultMap="tryDiaryDetailResultMap">
        SELECT td.try_diary_id, td.title, td.created_time,
               p.perfume_id, p.image_route, p.perfume_name, p.brand,
               tdp.description
        FROM try_diary td
        LEFT JOIN try_diary_perfume tdp ON td.try_diary_id = tdp.try_diary_id
            AND <include refid="common.notDeletedWithAlias"><property name="alias" value="tdp"/></include>
        LEFT JOIN perfume p ON tdp.perfume_id = p.perfume_id
        WHERE td.try_diary_id = #{tryDiaryId}
          AND <include refid="common.notDeletedWithAlias"><property name="alias" value="td"/></include>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="tryDiaryId">
        INSERT INTO try_diary (member_id, title, image_route,
            <include refid="common.insertCommonColumns"/>)
        VALUES (#{memberId}, #{title}, #{imageRoute},
            <include refid="common.insertCommonValues"/>)
    </insert>

</mapper>
