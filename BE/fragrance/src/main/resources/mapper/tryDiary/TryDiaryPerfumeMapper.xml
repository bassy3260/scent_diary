<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fragrance.tryDiray.mapper.TryDiaryPerfumeMapper">

    <insert id="insertBatch">
        INSERT INTO try_diary_perfume (try_diary_id, perfume_id, description,
            <include refid="common.insertCommonColumns"/>)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.tryDiaryId}, #{item.perfumeId}, #{item.description},
                <include refid="common.insertCommonValues"/>)
        </foreach>
    </insert>

</mapper>
